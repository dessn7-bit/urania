ole": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Sergio A.", "family": "Dzib", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "2208", "published-online": {"date-parts": [[2011, 7, 26]]}, "container-title": ["The Astrophysical Journal"], "link": [{"URL": "http://stacks.iop.org/0004-637X/737/i=1/a=30/pdf", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2020, 11, 6]], "date-time": "2020-11-06T22:01:43Z", "timestamp": 1604700103000}, "score": 19.88095, "resource": {"primary": {"URL": "https://iopscience.iop.org/article/10.1088/0004-637X/737/1/30"}}, "issued": {"date-parts": [[2011, 7, 26]]}, "references-count": 36, "journal-issue": {"issue": "1", "published-print": {"date-parts": [[2011, 8, 10]]}}, "URL": "https://doi.org/10.1088/0004-637x/737/1/30", "ISSN": ["0004-637X", "1538-4357"], "issn-type": [{"value": "0004-637X", "type": "print"}, {"value": "1538-4357", "type": "electronic"}], "published": {"date-parts": [[2011, 7, 26]]}}, {"indexed": {"date-parts": [[2026, 7, 30]], "date-time": "2026-07-30T17:10:02Z", "timestamp": 1785431402122, "version": "3.56.0"}, "reference-count": 0, "publisher": "Universidad Complutense de Madrid (UCM)", "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["Hist. Comun. Soc."], "abstract": "<jats:p>In 2012, it was the LXX anniversary of the international emissions of the Spanish National Radio that, since 1977, have been issued under the name Spanish Foreign Radio. Although they started as an advertising instrument of the Franco dictatorship, the establishment of a Parliamentary Monarchy after Franco ´s dead, in 1975, supposed a change in the station. Right then, their emissions have served to export to the world the new democratic standards and values of Spain as a country.</jats:p>", "DOI": "10.5209/rev_hics.2013.v18.43962", "type": "journal-article", "created": {"date-parts": [[2014, 2, 11]], "date-time": "2014-02-11T02:51:31Z", "timestamp": 1392087091000}, "page": "219-230", "source": "Crossref", "is-referenced-by-count": 1, "title": ["De la propaganda franquista a la Marca España: 70 años de Radio Exterior de España", "From Franco´s propaganda to the Brand Spain: 70 years of Spanish Foreign Radio."], "prefix": "10.5209", "volume": "18", "author": [{"given": "Miguel Ángel", "family": "Ortiz Sobrino", "sequence": "first", "affiliation": [{"id": [{"id": "https://ror.org/02p0gd045", "id-type": "ROR", "asserted-by": "publisher"}], "name": "Universidad Complutense de Madrid"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "3169", "published-online": {"date-parts": [[2014, 1, 15]]}, "container-title": ["Historia y Comunicación Social"], "link": [{"URL": "https://revistas.ucm.es/index.php/HICS/article/download/43962/41568", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://revistas.ucm.es/index.php/HICS/article/download/43962/41568", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 7, 15]], "date-time": "2026-07-15T08:13:28Z", "timestamp": 1784103208000}, "score": 19.775093, "resource": {"primary": {"URL": "https://revistas.ucm.es/index.php/HICS/article/view/43962"}}, "issued": {"date-parts": [[2014, 1, 15]]}, "references-count": 0, "URL": "https://doi.org/10.5209/rev_hics.2013.v18.43962", "ISSN": ["1988-3056", "1137-0734"], "issn-type": [{"value": "1988-3056", "type": "electronic"}, {"value": "1137-0734", "type": "print"}], "published": {"date-parts": [[2014, 1, 15]]}}, {"indexed": {"date-parts": [[2023, 9, 24]], "date-time": "2023-09-24T04:02:44Z", "timestamp": 1695528164956}, "reference-count": 16, "publisher": "American Geophysical Union (AGU)", "issue": "4", "license": [{"start": {"date-parts": [[2012, 12, 7]], "date-time": "2012-12-07T00:00:00Z", "timestamp": 1354838400000}, "content-version": "vor", "delay-in-days": 8560, "URL": "http://onlinelibrary.wiley.com/termsAndConditions#vor"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["Radio Science"], "published-print": {"date-parts": [[1989, 7]]}, "abstract": "<jats:p>The technique used at present to obtain Faraday electron content from polarimeter ground measurements of beacon signals is briefly reviewed and its basic assumptions are pointed out. A new alternative method is described. This method obviates the knowledge of the orientation of the transmitted electrical field and removes the so‐called ambiguity problem and may be useful in the case of interrupted polarimeter records. It makes use of electron density profiles obtained from an ionosonde located near the subionospheric point. Numerical comparisons of this method with the conventional one give good agreement. This was made using the combination of data from geostationary satellites with ionogram records. The relative advantages of both techniques are pointed out.</jats:p>", "DOI": "10.1029/rs024i004p00539", "type": "journal-article", "created": {"date-parts": [[2008, 2, 6]], "date-time": "2008-02-06T15:18:17Z", "timestamp": 1202311097000}, "page": "539-547", "source": "Crossref", "is-referenced-by-count": 2, "title": ["Techniques to obtain Faraday electron content from polarimeter data at low and middle latitudes"], "prefix": "10.1029", "volume": "24", "author": [{"given": "Nieves Ortiz", "family": "de Adler", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Rodolfo G.", "family": "Ezquer", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "13", "published-online": {"date-parts": [[2012, 12, 7]]}, "container-title": ["Radio Science"], "language": "en", "link": [{"URL": "https://api.wiley.com/onlinelibrary/tdm/v1/articles/10.1029%2FRS024i004p00539", "content-type": "unspecified", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/RS024i004p00539", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2023, 9, 23]], "date-time": "2023-09-23T06:31:36Z", "timestamp": 1695450696000}, "score": 19.659267, "resource": {"primary": {"URL": "https://agupubs.onlinelibrary.wiley.com/doi/10.1029/RS024i004p00539"}}, "issued": {"date-parts": [[1989, 7]]}, "references-count": 16, "journal-issue": {"issue": "4", "published-print": {"date-parts": [[1989, 7]]}}, "alternative-id": ["10.1029/RS024i004p00539"], "URL": "https://doi.org/10.1029/rs024i004p00539", "archive": ["Portico"], "ISSN": ["0048-6604", "1944-799X"], "issn-type": [{"value": "0048-6604", "type": "print"}, {"value": "1944-799X", "type": "electronic"}], "published": {"date-parts": [[1989, 7]]}}], "items-per-page": 5, "query": {"start-index": 0, "search-terms": null}}}